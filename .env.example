# Usuario do painel admin
ADMIN_USER=admin

# Hash bcrypt da senha. Gere com: npm run hash-senha "sua-senha"
ADMIN_PASSWORD_HASH=

# Segredo para assinar os JWTs. Gere um valor longo e aleatorio.
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Porta do servidor (Render define PORT automaticamente)
PORT=3000

# Diretorio das imagens da galeria (opcional; padrao: ./uploads).
# Em disco persistente, aponte para la, ex.: /data/uploads
UPLOADS_DIR=

# Diretorio do banco SQLite (opcional; padrao: ./data).
# Em disco persistente, aponte para la, ex.: /data/data
DATA_DIR=